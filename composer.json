{
  "name": "axiom/data-forge",
  "type": "library",
  "description": "A typed DTO and data handling package for PHP.",
  "homepage": "https://github.com/larafoundry/data-forge",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.48 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/validation": "^10.48 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/container": "^10.48 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/translation": "^10.48 || ^11.0 || ^12.0 || ^13.0",
    "nesbot/carbon": "^2.72.6 || ^3.8.4"
  },
  "keywords": [
    "data transfer object",
    "dto",
    "laravel",
    "validation",
    "hydration"
  ],
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Axiom\\DataForge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "trungdev05",
      "email": "nguyentrung.ws.555@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/larafoundry/data-forge/issues",
    "source": "https://github.com/larafoundry/data-forge"
  },
  "scripts": {
    "audit": "composer audit --locked",
    "pint": "vendor/bin/pint",
    "pint:test": "vendor/bin/pint --test",
    "phpstan": "vendor/bin/phpstan",
    "test": "vendor/bin/phpunit"
  },
  "require-dev": {
    "laravel/pint": "^1.13 <1.21",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5.63"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.1.0"
    }
  }
}
