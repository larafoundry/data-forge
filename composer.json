    "illuminate/support": "^10.0"
  },
  "keywords": [
    "data",
    "bridge",
    "ws"
  ],
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Ws\\DataBridge\\": "src/"
    }
  },
  "authors": [
    {
      "name": "trungdev05",
