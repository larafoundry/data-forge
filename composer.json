{
  "name": "axiom/data-forge",
  "type": "composer-plugin",
  "version": "1.0.0",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.48",
    "illuminate/http": "^10.48",
    "illuminate/validation": "^10.48",
    "illuminate/database": "^1.1",
    "illuminate/container": "^10.48"
  },
  "keywords": [
    "data",
    "forge",
    "axiom"
  ],
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Axiom\\DataForge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "trungdev05",
      "email": "nguyentrung.ws.555@gmail.com"
    }
  ],
  "scripts": {
    "pint": "vendor/bin/pint",
    "phpstan": "vendor/bin/phpstan",
    "test": "vendor/bin/pest"
  },
  "minimum-stability": "stable",
  "require-dev": {
    "laravel/pint": "^1.22",
    "phpstan/phpstan": "^2.1",
    "pestphp/pest": "^3.8",
    "fakerphp/faker": "^1.24"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
